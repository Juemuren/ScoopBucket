{
    "version": "2026-06-11",
    "description": "A software distro and building platform for Windows.",
    "homepage": "http://www.msys2.org/",
    "license": "GPL-2.0-only|BSD-3-Clause",
    "notes": [
        "Setup: $dir\\setup.ps1"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/msys2/msys2-installer/releases/download/2026-06-11/msys2-base-x86_64-20260611.tar.xz",
            "hash": "a2d047e8ee213c3c6a49a8de427eb1069df12207c0422ff1b3cbb5c905c34221",
            "extract_dir": "msys64"
        }
    },
    "bin": [
        [
            "msys2_shell.cmd",
            "msys2",
            "-defterm -here -no-start -full-path"
        ],
        [
            "msys2_shell.cmd",
            "clang64",
            "-clang64 -defterm -here -no-start -full-path"
        ],
        [
            "msys2_shell.cmd",
            "mingw64",
            "-mingw64 -defterm -here -no-start -full-path"
        ],
        [
            "msys2_shell.cmd",
            "ucrt64",
            "-ucrt64 -defterm -here -no-start -full-path"
        ]
    ],
    "env_set": {
        "MSYS": "winsymlinks:nativestrict",
        "MSYS_INSTALL_ROOT": "$dir"
    },
    "persist": [
        "home",
        "etc",
        "dev",
        "tmp",
        "opt",
        "usr",
        "var",
        "clang64",
        "mingw64",
        "ucrt64"
    ],
    "post_install": [
        "$scriptsdir = \"$bucketsdir\\$bucket\\scripts\\$app\"",
        "Copy-Item \"$scriptsdir\\setup.ps1\" \"$dir\\setup.ps1\""
    ],
    "checkver": {
        "url": "https://github.com/msys2/msys2-installer/releases",
        "regex": "/releases/tag/(?<version>(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2}))"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/msys2/msys2-installer/releases/download/$version/msys2-base-x86_64-$matchYear$matchMonth$matchDay.tar.xz"
            }
        }
    }
}
