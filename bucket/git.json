{
    "version": "2.56.0.4",
    "description": "A free and open source distributed version control system.",
    "homepage": "https://gitforwindows.org",
    "license": {
        "identifier": "GPL-2.0-only",
        "url": "https://github.com/git-for-windows/git/blob/HEAD/COPYING"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/git-for-windows/git/releases/download/v2.56.0.windows.4/PortableGit-2.56.0.4-64-bit.7z.exe#/dl.7z",
            "hash": "b1f3e52216e2ed6882d1bebfd4d3fdf319bec40d2edbbf9fd26ec4fd3fce7ed1"
        },
        "arm64": {
            "url": "https://github.com/git-for-windows/git/releases/download/v2.56.0.windows.4/PortableGit-2.56.0.4-arm64.7z.exe#/dl.7z",
            "hash": "044110f9d951858452ddb5e4b5415ea0f2b5b2598e794d6fec77fe28b9aa8cc0"
        }
    },
    "env_set": {
        "GIT_ROOT": "$dir"
    },
    "bin": [
        "bin\\sh.exe",
        "bin\\git.exe",
        [
            "bin\\bash.exe",
            "git-bash"
        ]
    ],
    "post_install": [
        "Start-Process -FilePath \"$dir\\post-install.bat\" -WorkingDirectory $dir -Wait -NoNewWindow",
        "& \"$dir\\bin\\git.exe\" config --system credential.helper manager"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/git-for-windows/git/releases/latest",
        "jsonpath": "$.assets[?(@.name =~ /Portable/i)].browser_download_url",
        "regex": "(?i)download/(?<tag>v?[\\d.]+windows[\\d.]+)/PortableGit-([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/git-for-windows/git/releases/download/$matchTag/PortableGit-$version-64-bit.7z.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/git-for-windows/git/releases/download/$matchTag/PortableGit-$version-arm64.7z.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://github.com/git-for-windows/git/releases/tag/$matchTag",
            "regex": "(?s)$basename.*?$sha256"
        }
    }
}
