{
    "version": "0.2.6.2",
    "description": "GHCup is the main installer for the general purpose language Haskell",
    "homepage": "https://www.haskell.org/ghcup",
    "license": "LGPL-v3",
    "notes": [
        "cabal user-config update --augment \"extra-include-dirs: `\"$env:GHCUP_MSYS2\\mingw64\\include`\"\"",
        "cabal user-config update --augment \"extra-lib-dirs: `\"$env:GHCUP_MSYS2\\mingw64\\lib`\"\"",
        "cabal user-config update --augment \"extra-prog-path: `\"$env:GHCUP_INSTALL_BASE_PREFIX\\ghcup\\bin`\", `\"$env:GHCUP_INSTALL_BASE_PREFIX\\.cabal\\bin`\", `\"$env:GHCUP_MSYS2\\mingw64\\bin`\", `\"$env:GHCUP_MSYS2\\usr\\bin`\"\""
    ],
    "depends": "msys2",
    "architecture": {
        "64bit": {
            "url": "https://github.com/haskell/ghcup-hs/releases/download/v0.2.6.2/x86_64-mingw64-ghcup-0.2.6.2.exe#/ghcup.exe",
            "hash": "94da902a2853b1de1df509d04da900a05258480759efdb4f654e66956b6f30db"
        }
    },
    "env_set": {
        "CABAL_DIR": "$dir\\.cabal",
        "GHCUP_INSTALL_BASE_PREFIX": "$dir",
        "GHCUP_MSYS2": "$scoopdir\\apps\\msys2\\current"
    },
    "env_add_path": "ghcup\\bin",
    "bin": "ghcup.exe",
    "persist": [
        ".cabal",
        "ghcup"
    ],
    "checkver": {
        "github": "https://github.com/haskell/ghcup-hs"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/haskell/ghcup-hs/releases/download/v$version/x86_64-mingw64-ghcup-$version.exe#/ghcup.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "regex": "$sha256\\s*(\\./)?$basename"
        }
    }
}
